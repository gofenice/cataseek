# ─── Cataseek environment configuration ─────────────────────────────────────────
# Copy this file to `.env` and fill in real values. Never commit `.env`.

# ── Server ──
NODE_ENV=production
PORT=3000
# Public URL of the APP (login/dashboard). Used in emails and payment links.
# Production example: https://app.yourdomain.com
FRONTEND_URL=http://localhost:3000
# Hostname whose root URL redirects to the super-admin area (/admin).
# Leave empty to disable. Production example: console.yourdomain.com
SUPERADMIN_HOST=

# ── Database (MySQL) ──
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=cataseek

# ── Meilisearch ──
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_KEY=

# ── Auth ──
# Generate a long random string, e.g.:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING
JWT_EXPIRES_IN=7d

# ── Admin account (used by seed-admin.ts) ──
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ── Email (SMTP) ──
# Any provider works (Brevo, SendGrid, Mailgun, Amazon SES, your domain SMTP).
SMTP_HOST=smtp.yourprovider.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Cataseek" <no-reply@yourdomain.com>

# ── Invoice/company branding (can also be set in Admin → Payment Settings) ──
COMPANY_NAME=Cataseek
COMPANY_EMAIL=billing@yourdomain.com
# Optional: a hosted logo image for invoice PDFs
LOGO_URL=

# ── Razorpay ──
# Keys can be managed in Admin → Payment Settings (stored in DB). When the key id
# + secret are set here they OVERRIDE the DB values, and the webhook secret is then
# read from here too (set all three or none), so each environment carries its own keys:
# rzp_test_… keys locally, rzp_live_… keys in production. The mode (test/live)
# follows the key prefix, and Cataseek plans are mapped to Razorpay plans per
# mode in Admin → Payment Settings → Plan mapping.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Webhook URL to register in the Razorpay Dashboard (same mode as the keys):
#   https://app.yourdomain.com/api/billing/razorpay/webhook
# Events: subscription.authenticated, subscription.activated, subscription.charged,
#   subscription.pending, subscription.halted, subscription.cancelled,
#   subscription.completed, subscription.paused, subscription.resumed,
#   subscription.updated, payment.failed
